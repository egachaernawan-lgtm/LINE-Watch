# Vercel demo: set only this (no backend, database or Google login needed); data comes from src/data/snapshot.json
# NEXT_PUBLIC_DEMO_MODE=true
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Same secret as the backend's BACKEND_JWT_SECRET
BACKEND_JWT_SECRET=change-me-long-random-string
BACKEND_URL=http://localhost:8080
# Comma-separated allow-list (must also be set on the backend)
ALLOWED_EMAILS=you@example.com

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Same secret as the backend's BACKEND_JWT_SECRET
BACKEND_JWT_SECRET=change-me-long-random-string

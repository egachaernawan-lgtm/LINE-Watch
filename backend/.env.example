ENV=local
DATABASE_URL=postgresql+asyncpg://linewatch:linewatch@localhost:5432/linewatch
CORS_ORIGINS=["http://localhost:3000"]

# Auth (must match frontend BACKEND_JWT_SECRET). Emails as JSON lists.
BACKEND_JWT_SECRET=change-me-long-random-string
ALLOWED_EMAILS=["you@example.com"]
ADMIN_EMAILS=["you@example.com"]
AUTH_DISABLED=false

# Cloud Scheduler OIDC (leave blank locally). INTERNAL_API_KEY lets you curl /internal/* locally.
SCHEDULER_AUDIENCE=
SCHEDULER_SERVICE_ACCOUNT=
INTERNAL_API_KEY=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Google service account (path to JSON file or the JSON itself). Share the Sheet with its email;
# put the Drive folder in a Shared Drive and add the account as a member.
GOOGLE_SERVICE_ACCOUNT_JSON=
SHEETS_SPREADSHEET_ID=
DRIVE_REPORTS_FOLDER_ID=

SENDGRID_API_KEY=
EMAIL_FROM=
REPORT_RECIPIENTS=["team@example.com"]

FRONTEND_URL=http://localhost:3000

# Free tier is per model: 5 requests/min, 20 requests/day. Articles are sent 5 per request.
# GEMINI_REQUESTS_PER_MINUTE=5
# GEMINI_BATCH_SIZE=5
# Tried in order when GEMINI_MODEL is out of quota (JSON list)
# GEMINI_FALLBACK_MODELS=["gemini-3.5-flash-lite","gemini-3.1-flash-lite"]
